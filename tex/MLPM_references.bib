@article{bisschopsLargeUltraprecisionMotion2001,
   author = {Bisschops, T. and Vijfvinkel, J.},
   title = {Large ultra-precision motion feedthrough designs},
   journal = {Vacuum},
   volume = {60},
   number = {1},
   pages = {161–165},
   abstract = {In the near future some precision machining and production processes like lithography will need a controlled gaseous atmosphere or vacuum environment. This paper considers some of the serious problems that are encountered when a large workpiece or substrate has to be positioned with micrometre or nanometre accuracy in a vacuum system. Especially in production machines, which require high speed (21m/s), high acceleration (1g) and long-stroke XY-motion (50×50cm), it is preferred to place the long stroke actuators with their bearings and multi-kilowatt drives, outside the vacuum system. Some feedthrough designs, based on differential pumping, that meet the mechanical and vacuum requirements are presented.},
